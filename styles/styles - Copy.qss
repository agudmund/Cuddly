/* Main Window & Central Layout */
QMainWindow, QWidget#centralWidget {
    background-color: #1e1e1e;
}

QLabel#statusLabel {
    color: #8a7a67;
    font-size: 13px;
}

/* The Cozy Preview Card */
QFrame#PreviewCard {
    border: 2px solid #6b5a47;
    border-radius: 12px;
    background-color: #2a2a3a;
    padding: 1px;
}

QLabel#WelcomeLabel {
    border: 1px dashed #8a7a67;
    border-radius: 10px;
    background-color: #2a2a3a;
    color: #e8f0ff;
    padding: 12px;
    font-size: 14px;
    min-height: 100px; /* Add this to prevent 'scaling downward' */

/* UI Elements (Buttons/Progress) */
QPushButton {
    background-color: #3a3a3a;
    border: 1px solid #6b5a47;
    border-radius: 8px;
    color: #e0e0e0;
    padding: 5px;
}

QProgressBar {
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    background-color: #121212;
    color: transparent;
    height: 10px;
}
/*
QProgressBar::chunk {
    background-color: #6b5a47;
    border-radius: 3px;
}
*/
QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6b5a47, stop:1 #8a7a67);
}